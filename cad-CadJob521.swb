Private Declare PtrSafe Function Execute Lib "C:\Users\RobotComp.ru\Desktop\dpw_project\.cad-work\CadJob521Loader.dll" (ByVal app As LongPtr, ByVal mode As LongPtr) As Long
Dim swApp As Object
Sub main()
 Dim mode As String
 Dim result As Long
 Dim report As Object
 Dim message As String
 On Error GoTo failed
 Set swApp = Application.SldWorks
 mode = "resize-save-warning-read"
 result = Execute(ObjPtr(swApp), StrPtr(mode))
 Exit Sub
failed:
 message = CStr(Err.Number) & " " & Err.Description
 Set report = CreateObject("Scripting.FileSystemObject").CreateTextFile("C:\Users\RobotComp.ru\Desktop\dpw_project\.cad-work\CadJob521-native-error.txt", True, True)
 report.WriteLine message
 report.WriteLine "DLL exists: " & CreateObject("Scripting.FileSystemObject").FileExists("C:\Users\RobotComp.ru\Desktop\dpw_project\.cad-work\CadJob521Loader.dll")
 report.Close
End Sub