Dim swApp As Object
Dim swModel As Object
Dim outFile As Object

Function MateErrorCount() As Long
    Dim f As Object
    Dim sf As Object
    Dim warn As Boolean
    Dim n As Long
    On Error Resume Next
    Set f = swModel.FirstFeature
    Do While Not f Is Nothing
        If f.GetTypeName2 = "MateGroup" Then
            Set sf = f.GetFirstSubFeature
            Do While Not sf Is Nothing
                If sf.GetErrorCode2(warn) <> 0 Then
                    n = n + 1
                    outFile.WriteLine "ERROR " & sf.Name
                End If
                Set sf = sf.GetNextSubFeature
            Loop
        End If
        Set f = f.GetNextFeature
    Loop
    MateErrorCount = n
End Function

Sub main()
    Dim fso As Object
    Dim f As Object
    Dim sf As Object
    Dim target As Object
    Dim mate As Object
    Dim car As Object
    Dim part As Object
    Dim bodies As Variant
    Dim body As Object
    Dim faces As Variant
    Dim face As Object
    Dim surface As Object
    Dim cp As Variant
    Dim cylinder As Object
    Dim baseCylinder As Object
    Dim def As Object
    Dim oldArray As Variant
    Dim oldEntities(1) As Object
    Dim newEntities(1) As Object
    Dim oldAlign As Long
    Dim i As Long
    Dim j As Long
    Dim count As Long
    Dim distance As Double
    Dim norm As Double
    Dim ok As Boolean
    On Error Resume Next
    Set swApp = Application.SldWorks
    Set swModel = swApp.ActiveDoc
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set outFile = fso.CreateTextFile("C:\Users\RobotComp.ru\Desktop\dpw_project\tools\mate48\full-concentric.txt", True, True)
    Set f = swModel.FirstFeature
    Do While Not f Is Nothing
        If f.GetTypeName2 = "MateGroup" Then
            Set sf = f.GetFirstSubFeature
            Do While Not sf Is Nothing
                If sf.GetTypeName2 = "MateConcentric" And Right(sf.Name, 2) = "48" Then Set target = sf
                Set sf = sf.GetNextSubFeature
            Loop
        End If
        Set f = f.GetNextFeature
    Loop
    If target Is Nothing Then
        outFile.WriteLine "MISSING TARGET; NO CHANGE"
        outFile.Close
        Exit Sub
    End If
    Set mate = target.GetSpecificFeature2
    Set car = mate.MateEntity(0).ReferenceComponent
    Set baseCylinder = mate.MateEntity(1).Reference
    Set surface = baseCylinder.GetSurface
    If Not surface.IsCylinder Then
        outFile.WriteLine "MISSING BASE CYLINDER; NO CHANGE"
        outFile.Close
        Exit Sub
    End If
    Set part = car.GetModelDoc2
    bodies = part.GetBodies2(0, False)
    If IsArray(bodies) Then
        For i = LBound(bodies) To UBound(bodies)
            Set body = bodies(i)
            faces = body.GetFaces
            If IsArray(faces) Then
                For j = LBound(faces) To UBound(faces)
                    Set face = faces(j)
                    Set surface = face.GetSurface
                    If surface.IsCylinder Then
                        cp = surface.CylinderParams
                        norm = Sqr(cp(3) ^ 2 + cp(4) ^ 2 + cp(5) ^ 2)
                        distance = Sqr((cp(1) * cp(5) - cp(2) * cp(4)) ^ 2 + (cp(2) * cp(3) - cp(0) * cp(5)) ^ 2 + (cp(0) * cp(4) - cp(1) * cp(3)) ^ 2) / norm
                        If Abs(cp(6) - 0.00251) < 0.00000001 And distance < 0.00000001 And Abs(cp(4)) > 0.9999 Then
                            Set cylinder = car.GetCorrespondingEntity(face)
                            outFile.WriteLine "SAME CENTRAL HOLE FOUND; RADIUS " & cp(6) & " LOCAL_AXIS_DISTANCE " & distance
                            Exit For
                        End If
                    End If
                Next j
            End If
            If Not cylinder Is Nothing Then Exit For
        Next i
    End If
    If cylinder Is Nothing Then
        outFile.WriteLine "MISSING CAR CYLINDER; NO CHANGE"
        outFile.Close
        Exit Sub
    End If
    Set def = target.GetDefinition
    oldArray = def.EntitiesToMate
    Set oldEntities(0) = oldArray(0)
    Set oldEntities(1) = oldArray(1)
    oldAlign = def.MateAlignment
    Set newEntities(0) = cylinder
    Set newEntities(1) = baseCylinder
    def.EntitiesToMate = newEntities
    def.MateAlignment = 2
    def.LockRotation = False
    Err.Clear
    ok = target.ModifyDefinition(def, swModel, Nothing)
    outFile.WriteLine "MODIFIED " & ok & " API_ERROR " & Err.Number & " " & Err.Description
    ok = swModel.ForceRebuild3(False)
    count = MateErrorCount()
    outFile.WriteLine "REBUILT " & ok & " ERROR_COUNT " & count
    If count = 0 And ok Then
        outFile.WriteLine "FULL CYLINDER-CYLINDER CONCENTRIC48 ACTIVE; DISTANCE4 SUPPRESSED"
    Else
        Set def = target.GetDefinition
        def.EntitiesToMate = oldEntities
        def.MateAlignment = oldAlign
        ok = target.ModifyDefinition(def, swModel, Nothing)
        ok = swModel.ForceRebuild3(False)
        outFile.WriteLine "ORIGINAL POINT-CYLINDER STATE RESTORED"
    End If
    swModel.ClearSelection2 True
    swModel.GraphicsRedraw2
    outFile.WriteLine "DONE"
    outFile.Close
End Sub
