Dim swApp As Object
Dim swModel As Object
Dim outFile As Object

Function ErrorCount() As Long
    Dim f As Object
    Dim sf As Object
    Dim warning As Boolean
    Dim code As Long
    Dim total As Long
    On Error Resume Next
    Set f = swModel.FirstFeature
    Do While Not f Is Nothing
        If f.GetTypeName2 = "MateGroup" Then
            Set sf = f.GetFirstSubFeature
            Do While Not sf Is Nothing
                code = sf.GetErrorCode2(warning)
                If code <> 0 Then
                    total = total + 1
                    outFile.WriteLine " ERROR " & sf.Name & " code=" & code
                End If
                Set sf = sf.GetNextSubFeature
            Loop
        End If
        Set f = f.GetNextFeature
    Loop
    ErrorCount = total
End Function

Sub main()
    Dim fso As Object
    Dim f As Object
    Dim sf As Object
    Dim p6 As Object
    Dim p9 As Object
    Dim c48 As Object
    Dim count As Long
    Dim ok As Boolean
    On Error Resume Next
    Set swApp = Application.SldWorks
    Set swModel = swApp.ActiveDoc
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set outFile = fso.CreateTextFile("C:\Users\RobotComp.ru\Desktop\dpw_project\tools\mate48\parallel-probe.txt", True, True)
    Set f = swModel.FirstFeature
    Do While Not f Is Nothing
        If f.GetTypeName2 = "MateGroup" Then
            Set sf = f.GetFirstSubFeature
            Do While Not sf Is Nothing
                If sf.GetTypeName2 = "MateParallel" Then
                    If Right(sf.Name, 1) = "6" Then Set p6 = sf
                    If Right(sf.Name, 1) = "9" Then Set p9 = sf
                End If
                If sf.GetTypeName2 = "MateConcentric" And Right(sf.Name, 2) = "48" Then Set c48 = sf
                Set sf = sf.GetNextSubFeature
            Loop
        End If
        Set f = f.GetNextFeature
    Loop
    If p6 Is Nothing Or p9 Is Nothing Or c48 Is Nothing Then
        outFile.WriteLine "MISSING EXPECTED MATE"
        outFile.Close
        Exit Sub
    End If
    outFile.WriteLine "BASELINE"
    count = ErrorCount()
    outFile.WriteLine "COUNT " & count
    outFile.WriteLine "TEST SUPPRESS PARALLEL9"
    ok = p9.SetSuppression2(0, 1, Empty)
    ok = swModel.ForceRebuild3(False)
    count = ErrorCount()
    outFile.WriteLine "COUNT " & count
    If count = 0 Then
        outFile.WriteLine "KEPT PARALLEL9 SUPPRESSED; CONCENTRIC48 ACTIVE"
        outFile.Close
        Exit Sub
    End If
    ok = p9.SetSuppression2(1, 1, Empty)
    outFile.WriteLine "TEST SUPPRESS PARALLEL6"
    ok = p6.SetSuppression2(0, 1, Empty)
    ok = swModel.ForceRebuild3(False)
    count = ErrorCount()
    outFile.WriteLine "COUNT " & count
    If count = 0 Then
        outFile.WriteLine "KEPT PARALLEL6 SUPPRESSED; CONCENTRIC48 ACTIVE"
        outFile.Close
        Exit Sub
    End If
    outFile.WriteLine "TEST SUPPRESS BOTH PARALLELS"
    ok = p9.SetSuppression2(0, 1, Empty)
    ok = swModel.ForceRebuild3(False)
    count = ErrorCount()
    outFile.WriteLine "COUNT " & count
    If count = 0 Then
        outFile.WriteLine "KEPT BOTH REDUNDANT PARALLELS SUPPRESSED; CONCENTRIC48 ACTIVE"
    Else
        ok = p6.SetSuppression2(1, 1, Empty)
        ok = p9.SetSuppression2(1, 1, Empty)
        ok = swModel.ForceRebuild3(False)
        outFile.WriteLine "RESTORED ORIGINAL STATE"
    End If
    swModel.ClearSelection2 True
    swModel.GraphicsRedraw2
    outFile.WriteLine "DONE"
    outFile.Close
End Sub
