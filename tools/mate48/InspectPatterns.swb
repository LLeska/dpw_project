Dim swApp As Object
Dim swModel As Object
Dim outFile As Object

Sub main()
    Dim fso As Object
    Dim f As Object
    Dim def As Object
    Dim axis As Object
    Dim comp As Object
    Dim seeds As Variant
    Dim seed As Object
    Dim j As Long
    Dim ok As Boolean
    On Error Resume Next
    Set swApp = Application.SldWorks
    Set swModel = swApp.ActiveDoc
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set outFile = fso.CreateTextFile("C:\Users\RobotComp.ru\Desktop\dpw_project\tools\mate48\patterns.txt", True, True)
    Set f = swModel.FirstFeature
    Do While Not f Is Nothing
        If f.GetTypeName2 = "LocalLPattern" Then
            outFile.WriteLine "PATTERN " & f.Name
            Set def = f.GetDefinition
            ok = def.AccessSelections(swModel, Nothing)
            outFile.WriteLine "ACCESS " & ok
            outFile.WriteLine "AXIS_TYPE " & def.GetD1AxisType & " REVERSE " & def.D1ReverseDirection & " SPACING " & def.D1Spacing & " END " & def.D1EndCondition
            Set axis = Nothing
            Set comp = Nothing
            Set axis = def.D1Axis
            outFile.WriteLine "AXIS_OBJECT " & TypeName(axis)
            Set comp = axis.GetComponent
            If Not comp Is Nothing Then outFile.WriteLine "AXIS_COMPONENT " & comp.Name2
            seeds = def.SeedComponentArray
            If IsArray(seeds) Then
                For j = LBound(seeds) To UBound(seeds)
                    Set seed = seeds(j)
                    outFile.WriteLine "SEED " & seed.Name2
                Next j
            End If
            def.ReleaseSelectionAccess
        End If
        Set f = f.GetNextFeature
    Loop
    swModel.ClearSelection2 True
    outFile.WriteLine "DONE"
    outFile.Close
End Sub
